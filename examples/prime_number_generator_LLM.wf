  <graph edgedefault="directed">
    <node id="cf7bb102-eb38-442a-bbdf-6a688802514a">
      <data key="d1"># Input prime numbers
echo "2" &gt; /tmp/sequence.txt
echo "3" &gt;&gt; /tmp/sequence.txt
echo "5" &gt;&gt; /tmp/sequence.txt
echo "7" &gt;&gt; /tmp/sequence.txt
echo "11" &gt;&gt; /tmp/sequence.txt</data>
      <data key="d2">369.89107749519735</data>
      <data key="d3">10.930778879790012</data>
      <data key="d4">ran</data>
      <data key="d5">sleep 1
#MODEL=gemma4:31b-cloud
MODEL=gemma4:e2b
 # Input prime numbers
echo "2" &gt; /tmp/sequence.txt
echo "3" &gt;&gt; /tmp/sequence.txt
echo "5" &gt;&gt; /tmp/sequence.txt
echo "7" &gt;&gt; /tmp/sequence.txt
echo "11" &gt;&gt; /tmp/sequence.txt</data>
      <data key="d6" />
      <data key="d7" />
      <data key="d8">91145</data>
      <data key="d9">0</data>
    </node>
    <node id="3955c2d4-4d4d-4f5b-8d95-133a2bedd081">
      <data key="d1"># Generate the next number in the sequence
tail -n 50 /tmp/sequence.txt | \
ollama run "$MODEL" \
  --hidethinking \
  --think=false \
  "Whats the next number in the sequence? output the next number ONLY" \
  &gt; /tmp/next.txt 2&gt;/dev/null</data>
      <data key="d2">671.9230615903364</data>
      <data key="d3">15.703755892413682</data>
      <data key="d4">ran</data>
      <data key="d5">sleep 1
#MODEL=gemma4:31b-cloud
MODEL=gemma4:e2b
 # Generate the next number in the sequence
tail -n 50 /tmp/sequence.txt | \
ollama run "$MODEL" \
  --hidethinking \
  --think=false \
  "Whats the next number in the sequence? output the next number ONLY" \
  &gt; /tmp/next.txt 2&gt;/dev/null</data>
      <data key="d8">155172</data>
      <data key="d9">0</data>
      <data key="d6" />
      <data key="d7" />
    </node>
    <node id="f93354c4-e911-4a1b-a2b5-789f71846d76">
      <data key="d1"># Merge with the sequence
cat \
  /tmp/next.txt \
  &gt;&gt; /tmp/sequence.txt</data>
      <data key="d2">1279.0103240537562</data>
      <data key="d3">35.22152236152846</data>
      <data key="d4">fail</data>
      <data key="d5">sleep 1
#MODEL=gemma4:31b-cloud
MODEL=gemma4:e2b
 # Merge with the sequence
cat \
  /tmp/next.txt \
  &gt;&gt; /tmp/sequence.txt</data>
      <data key="d6" />
      <data key="d7" />
      <data key="d8">155290</data>
      <data key="d9">-9</data>
    </node>
    <node id="c22c2386-f18c-449e-a140-0c841f49acd5">
      <data key="d1"># If there are more than 20 lines, quit the loop
[ "$(wc -l &lt; /tmp/sequence.txt)" -le 2000 ] || exit 1</data>
      <data key="d2">1011.9966934943847</data>
