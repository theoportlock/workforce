<?xml version='1.0' encoding='utf-8'?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://graphml.graphdrawing.org/xmlns http://graphml.graphdrawing.org/xmlns/1.0/graphml.xsd"><key id="d7" for="edge" attr.name="status" attr.type="string"/>
<key id="d6" for="edge" attr.name="edge_type" attr.type="string"/>
<key id="d5" for="edge" attr.name="id" attr.type="string"/>
<key id="d4" for="node" attr.name="status" attr.type="string"/>
<key id="d3" for="node" attr.name="y" attr.type="string"/>
<key id="d2" for="node" attr.name="x" attr.type="string"/>
<key id="d1" for="node" attr.name="label" attr.type="string"/>
<key id="d0" for="graph" attr.name="wrapper" attr.type="string"/>
<graph edgedefault="directed"><data key="d0">sleep 1
#MODEL=gemma4:31b-cloud
MODEL=gemma4:e2b
</data>
<node id="cf7bb102-eb38-442a-bbdf-6a688802514a">
  <data key="d1"># Input prime numbers
echo "2" &gt; /tmp/sequence.txt
echo "3" &gt;&gt; /tmp/sequence.txt
echo "5" &gt;&gt; /tmp/sequence.txt
echo "7" &gt;&gt; /tmp/sequence.txt
echo "11" &gt;&gt; /tmp/sequence.txt</data>
  <data key="d2">369.89107749519735</data>
  <data key="d3">10.930778879790012</data>
  <data key="d4"></data>
</node>
<node id="3955c2d4-4d4d-4f5b-8d95-133a2bedd081">
  <data key="d1"># Generate the next number in the sequence
tail -n 50 /tmp/sequence.txt | \
ollama run "$MODEL" \
  --hidethinking \
  --think=false \
  "Whats the next number in the sequence? output the next number ONLY" \
  &gt; /tmp/next.txt</data>
  <data key="d2">671.9230615903364</data>
  <data key="d3">15.703755892413682</data>
  <data key="d4"></data>
</node>
<node id="f93354c4-e911-4a1b-a2b5-789f71846d76">
  <data key="d1"># Merge with the sequence
cat \
  /tmp/next.txt \
  &gt;&gt; /tmp/sequence.txt</data>
  <data key="d2">1279.0103240537562</data>
  <data key="d3">35.22152236152846</data>
  <data key="d4"></data>
</node>
<node id="c22c2386-f18c-449e-a140-0c841f49acd5">
  <data key="d1"># If there are more than 20 lines, quit the loop
[ "$(wc -l &lt; /tmp/sequence.txt)" -le 2000 ] || exit 1</data>
  <data key="d2">1011.9966934943847</data>
  <data key="d3">219.32324704091673</data>
  <data key="d4"></data>
</node>
<node id="fb1a5736-d45f-4332-a30c-4af4395abd37">
  <data key="d1"># Show the sequence
cat /tmp/sequence.txt</data>
  <data key="d2">1532.7894320489768</data>
  <data key="d3">50.94497820916483</data>
  <data key="d4"></data>
</node>
<node id="ab0b260a-9b9e-426b-9d52-f739cdd21b84">
  <data key="d1"># Pull the model
ollama pull $MODEL </data>
  <data key="d2">572.5705454783135</data>
  <data key="d3">-107.25872272588472</data>
  <data key="d4"></data>
</node>
