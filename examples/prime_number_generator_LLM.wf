<node id="3955c2d4-4d4d-4f5b-8d95-133a2bedd081">
  <data key="d1"># Look at the previous 5 numbers and guess the next one
tail -n 5 /tmp/sequence.txt | ollama run "$MODEL" \
  --hidethinking \
  --think=false \
  "Whats the next number in the sequence? output the next number ONLY" \
  &gt; /tmp/next.txt</data>
